datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum BookingStatus {
  DIPROSES
  DISETUJUI
  SELESAI
  DIBATALKAN
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String?
  role      Role      @default(CUSTOMER)
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

model Car {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  category     String
  pricePerDay  Int
  capacity     String
  transmission String
  engine       String
  features     String[]
  image        String
  popular      Boolean   @default(false)
  isAvailable  Boolean   @default(true)
  createdAt    DateTime  @default(now())
  bookings     Booking[]
}

model Booking {
  id          String        @id @default(cuid())
  bookingCode String        @unique
  userId      String?
  user        User?         @relation(fields: [userId], references: [id])
  carId       String
  car         Car           @relation(fields: [carId], references: [id])
  custName    String
  custPhone   String
  serviceType String
  startDate   DateTime
  endDate     DateTime
  totalPrice  Int
  status      BookingStatus @default(DIPROSES)
  createdAt   DateTime      @default(now())
}
